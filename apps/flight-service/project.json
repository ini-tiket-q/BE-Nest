{
  "name": "flight-service",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/flight-service/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nx/webpack:webpack",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "target": "node",
        "compiler": "tsc",
        "outputPath": "dist/apps/flight-service",
        "main": "apps/flight-service/src/main.ts",
        "tsConfig": "apps/flight-service/tsconfig.app.json",
        "assets": [
          "apps/flight-service/src/assets"
        ],
        "webpackConfig": "apps/flight-service/webpack.config.js"
      },
      "configurations": {
        "development": {},
        "production": {}
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "flight-service:build",
        "watch": false
      },
      "configurations": {
        "development": {
          "buildTarget": "flight-service:build:development"
        },
        "production": {
          "buildTarget": "flight-service:build:production"
        }
      }
    }
  },
  "tags": []
}
